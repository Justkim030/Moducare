# ModuCare MS — environment configuration (TEMPLATE)
# Copy this file to ".env" and fill in real values.
# ".env" is gitignored (never commit secrets). ".env.example" is committed for reference.

# Port the server listens on (default: 8081)
PORT=8081

# SQLite database location, relative to project root.
# Run `node server/migrate.js` once after cloning to create + seed this file.
# DATABASE_URL=sqlite://src/data/hospital.db

# Secret used to sign JWT session tokens.
# REQUIRED in production (the server refuses to start without it).
# For local development you may leave this empty — the server falls back to a
# shared, insecure default and prints a startup warning.
# Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

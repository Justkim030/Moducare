# ModuCare MS - Environment Configuration
# Copy this file to .env and update values for your environment

# Server Configuration
PORT=8081
NODE_ENV=development

# Database
DATABASE_URL=sqlite://src/data/hospital.db

# Security - REQUIRED in production
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRY=8h

# API Security
API_SECRET_PREFIX=moducare_secure_gate_99x

# Default passwords - Used only in development, REQUIRED in production
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_DEV_PASSWORD=dan123
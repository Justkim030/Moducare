  MEDICINE_ID string
  PATIENT_ID string
}

MEDICINE [icon: package, color: green]  {
  ID string pk
  NAME string
  QUANTITY string
  PRICE string
  DATE_ADDED string
}


EMPLOYEES [icon: users, color: green] {
  ID string pk
  PASSWORD string
  EMAIL string
  USERS_ID string
  DATE_ADDED string
}

PATIENT [icon: user, color: blue] {
  ID string pk
  NAME_ID string

}

PRESCRIPTION [icon: file-text, color: red] {
  ID string pk
  DATE_PRESCRIBE string
  STATUS string
  EMPLOYEE_ID string
  PATIENT_ID string
  DISPENSED_BY_ID string
  VISIT_ID string
}

TRIAGE [icon: user, color: orange]   {
  ID string pk
  CHIEF_COMPLAINT string
  TRIAGE_LEVEL string
  BODY_TEMP string
  BP_DIASTOLIC string
  BP_SYSTOLIC string
  HEART_RATE string
  WEIGHT string
}

FINANCE [icon: dollar-sign, color: green] {
  ID string pk
  AMOUNT string
  PAYMENT_METHOD string
  PAYMENT_DATE string
  VISIT_ID string
  EMPLOYEE_ID string
}

USERS.NAME_ID < NAMES.ID
EMPLOYEES.USERS_ID < USERS.ID
PATIENT.NAME_ID < NAMES.ID
PRESCRIPTION.EMPLOYEE_ID > EMPLOYEES.ID
PRESCRIPTION.PATIENT_ID > PATIENT.ID
PRESCRIPTION.DISPENSED_BY_ID > EMPLOYEES.ID
PRESCRIPTION.VISIT_ID > VISITS.ID
VISITS.PATIENT_ID > PATIENT.ID
VISITS.EMPLOYEE_ID > EMPLOYEES.ID
VISITS.TRIAGE_ID > TRIAGE.ID
PRESCRIPTION_RECORD.MEDICINE_ID > MEDICINE.ID
PRESCRIPTION_RECORD.PATIENT_ID > PATIENT.ID
FINANCE.VISIT_ID > EMPLOYEES.ID
  
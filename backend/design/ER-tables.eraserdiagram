  GENDER string
  AGE string
  PHONE_NUMBER string
}

USERS [icon: users, color: blue] {
  ID string pk
  NAME_ID string
  IS_SUPERUSER string
  USERNAME string
  EMPLOYEE_TYPE string
  LAST_LOGIN string
}

VISITS [icon: calendar, color: yellow] {
  ID string pk
  VISIT_DATE string
  STATUS string
  PATIENT_ID string
  EMPLOYEE_ID string
  CONSULTATION_NOTES string
  PHARMACY_NOTES string
  TRIAGE_ID string
}

PRESCRIPTION_RECORD [icon: list, color: red] {
  ID string pk
  QUANTITY string
